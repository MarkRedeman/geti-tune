{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Geti Edge",
    "version": "0.1.0",
    "identifier": "com.geti-edge.dev",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Geti Edge",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "externalBin": ["./../../dist/geti-edge"],
        "icon": ["icons/32x32.png"],
        "linux": {
            "rpm": {
                "compression": {
                    "type": "none"
                }
            }
        }
    }
}
